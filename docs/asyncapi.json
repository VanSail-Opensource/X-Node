  "info": {
    "title": "X-Node control channel",
    "version": "1.0.0"
  },
  "operations": {
    "receiveMasterState": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/control"
      }
    },
    "sendAgentReports": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/control"
      }
    }
  },
  "servers": {
    "master": {
      "host": "master.example.com",
      "protocol": "wss"
    }
  },
  "x-activity-observations": {
    "capability": "activity_observations_v1",
    "format": "observations-v1",
    "header": "X-XNode-Activity",
    "maxObservations": 16384,
    "volatile": true
  },
  "x-automatic-firewall-leases": {
    "absoluteDeadlines": true,
    "capability": "volatile_firewall_leases_v1",
    "command": "firewall.leases.update",
    "maximumBatch": 256,
    "maximumEntries": 100000,
    "schema": "schemas/automatic-leases.schema.json",
    "volatile": true
  },
  "x-hourly-account-limits": {
    "accountingIndependentOfAdmission": true,
    "accountingReceiptHeader": "X-XNode-Hourly-Accounting",
    "accountingReceiptValue": "v1",
    "capability": "hourly_account_limits_v1",
    "commands": [
      "hourly.credit.install",
      "hourly.credit.seal",
      "hourly.credit.ack"
    ],
    "exactSessionEcho": true,
    "failurePolicy": "pause hourly ingress; never restore grants or unused-credit proofs on disconnect",
    "maxAggregateBurstBytes": 16384,
    "maxFrameBytes": 65536,
    "maxGrantLifetimeMilliseconds": 10000,
    "maxItems": 128,
    "offerHeader": "X-XNode-Hourly",
    "offerValue": "v1",
    "schema": "schemas/hourly.schema.json",
    "sessionHeader": "X-XNode-Hourly-Session"
  },
  "x-report-framing": {
    "capability": "report_zstd_l6_v1",
    "codec": "zstandard",
    "decodedLength": "uint32-big-endian",
    "level": 6,
    "magicHex": "584e5a01",
    "maxDecodedBytes": 16777216,
    "maxEncodedBytes": 16909312,
    "offerHeader": "X-XNode-Reports",
    "offerValue": "zstd-l6-v1",
    "permessageDeflate": false
  },
  "x-traffic-streams": {
    "acknowledgement": "after atomic usage, financial effects and cursor commit",
    "barrierSchema": "schemas/traffic-barrier.schema.json",
    "capability": "traffic_stream_v1",
    "identity": "agent_id:boot_id:sequence",
    "lossPolicy": "settle surviving committed usage; never fabricate missing bytes or advance a cursor for lost reports",
    "offerHeader": "X-XNode-Traffic",
    "offerValue": "stream-v1",
    "reportSchema": "schemas/traffic-report.schema.json"
  }
}
