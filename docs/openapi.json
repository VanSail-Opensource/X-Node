{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The agent initiates one WSS connection. Application operations are WebSocket frames; no REST endpoints represent them.",
    "title": "X-Node master WebSocket contract",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/v1/agents/connect": {
      "get": {
        "operationId": "connectAgent",
        "parameters": [
          {
            "in": "header",
            "name": "Sec-WebSocket-Protocol",
            "required": true,
            "schema": {
              "const": "x-node.v1",
              "type": "string"
            }
          },
          {
            "description": "Offer compact telemetry for this authenticated connection. The master echoes the accepted format; absence selects legacy telemetry.",
            "in": "header",
            "name": "X-XNode-Telemetry",
            "required": false,
            "schema": {
              "const": "compact-v1",
              "type": "string"
            }
          },
          {
            "description": "Offer total open client connections. Only an echoed acceptance permits the extension in legacy or compact telemetry.",
            "in": "header",
            "name": "X-XNode-Open-Connections",
            "required": false,
            "schema": {
              "const": "v1",
              "type": "string"
            }
          },
          {
            "description": "Offer bounded boot-scoped IP observation history and actual sampling timestamps. Independent of compression and compact telemetry.",
            "in": "header",
            "name": "X-XNode-Activity",
            "required": false,
            "schema": {
              "const": "observations-v1",
              "type": "string"
            }
          },
          {
            "description": "Offer acknowledged DDNS changes. A master echoes the accepted format; absence preserves legacy DDNS reporting.",
            "in": "header",
            "name": "X-XNode-DDNS-Changes",
            "required": false,
            "schema": {
              "const": "acknowledged-v1",
              "type": "string"
            }
          },
          {
            "description": "Offer bounded numerical compute. Both the response header and hello capability are required.",
            "in": "header",
            "name": "X-Xnode-Compute-Pool",
            "required": false,
            "schema": {
              "const": "v1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket connection established",
            "headers": {
              "X-XNode-Activity": {
                "description": "Accepted activity observation extension; also requires the agent hello capability.",
                "schema": {
                  "const": "observations-v1",
                  "type": "string"
                }
              },
              "X-XNode-DDNS-Changes": {
                "description": "Accepted DDNS change format; also requires the hello capability.",
                "schema": {
                  "const": "acknowledged-v1",
                  "type": "string"
                }
              },
              "X-XNode-Open-Connections": {
                "description": "Accepted total open client connection extension; also requires the agent hello capability.",
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              },
              "X-XNode-Telemetry": {
                "description": "Accepted telemetry format; compact also requires the agent hello capability.",
                "schema": {
                  "const": "compact-v1",
                  "type": "string"
                }
              },
              "X-Xnode-Compute-Pool": {
                "description": "Accepted compute pool version.",
                "schema": {
                  "const": "v1",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing bearer credential"
          },
          "426": {
            "description": "WebSocket upgrade required"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Upgrade the authenticated agent connection to WebSocket",
        "x-websocket-messages": {
          "agentToMaster": [
            "agent.hello",
            "firewall.events",
            "state.request",
            "state.accepted",
            "state.applied",
            "state.failed",
            "telemetry.report",
            "traffic.report",
            "logs.report",
            "command.accepted",
            "command.progress",
            "command.result",
            "error",
            "firewall.pending",
            "torrent.detected",
            "torrent.expired",
            "admission.rejected",
            "telemetry.compact",
            "ddns.changes",
            "compute.claim",
            "compute.heartbeat",
            "compute.result",
            "compute.cancel"
          ],
          "masterToAgent": {
            "$ref": "schemas/master-message.schema.json"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://master.example.com"
    }
  ],
  "x-automatic-firewall-leases": {
    "absoluteDeadlines": true,
    "capability": "volatile_firewall_leases_v1",
    "command": "firewall.leases.update",
    "maximumBatch": 256,
    "maximumEntries": 100000,
    "schema": "schemas/automatic-leases.schema.json",
    "volatile": true
  },
  "x-report-framing": {
    "capability": "report_zstd_l6_v1",
    "codec": "zstandard",
    "decodedLength": "uint32-big-endian",
    "level": 6,
    "magicHex": "584e5a01",
    "maxDecodedBytes": 16777216,
    "maxEncodedBytes": 16909312,
    "offerHeader": "X-XNode-Reports",
    "offerValue": "zstd-l6-v1",
    "permessageDeflate": false
  },
  "x-traffic-streams": {
    "acknowledgement": "after atomic usage, financial effects and cursor commit",
    "barrierSchema": "schemas/traffic-barrier.schema.json",
    "capability": "traffic_stream_v1",
    "identity": "agent_id:boot_id:sequence",
    "lossPolicy": "settle surviving committed usage; never fabricate missing bytes or advance a cursor for lost reports",
    "offerHeader": "X-XNode-Traffic",
    "offerValue": "stream-v1",
    "reportSchema": "schemas/traffic-report.schema.json"
  }
}
