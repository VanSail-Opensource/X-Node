{
  "$id": "https://github.com/VanSail-Opensource/X-Node/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "blocked_domains": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocked_ports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "network": {
            "type": "string"
          },
          "to": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "certificates": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": false,
            "properties": {
              "auto_tls": {
                "type": "boolean"
              },
              "cert_content": {
                "type": "string"
              },
              "cert_file": {
                "type": "string"
              },
              "cert_mode": {
                "type": "string"
              },
              "dns_env": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "dns_provider": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "http_port": {
                "type": "integer"
              },
              "key_content": {
                "type": "string"
              },
              "key_file": {
                "type": "string"
              },
              "propagation_delay": {
                "type": "string"
              },
              "startup_timeout_seconds": {
                "type": "integer"
              }
            },
            "required": [
              "cert_mode"
            ],
            "type": "object"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "config"
        ],
        "type": "object"
      },
      "maxProperties": 64,
      "type": "object"
    },
    "ddns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "generation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "interface": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer"
          },
          "ipv4": {
            "type": "string"
          },
          "ipv4_url": {
            "type": "string"
          },
          "ipv6": {
            "type": "string"
          },
          "ipv6_url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "ttl_seconds": {
            "type": "integer"
          },
          "zone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "zone",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "dns": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "deprecated": true,
          "description": "Deprecated compatibility input. Empty/xray/smartdns are accepted; effective DNS always uses Xray. Legacy loopback behavior is migrated to native dns.servers.",
          "enum": [
            "",
            "xray",
            "smartdns"
          ],
          "type": "string"
        },
        "redirect": {
          "type": "boolean"
        },
        "upstreams": {
          "deprecated": true,
          "description": "Ignored compatibility input. Configure upstream resolvers through native Xray dns.servers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "firewall": {
      "additionalProperties": false,
      "properties": {
        "allow_prefixes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ban_seconds": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "forward": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "listen_ip": {
                "type": "string"
              },
              "network": {
                "type": "string"
              },
              "port": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "port_end": {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "target_ip": {
                "type": "string"
              },
              "target_port": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "target_port_end": {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "port",
              "target_ip",
              "target_port",
              "network"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "master_controlled": {
          "type": "boolean"
        },
        "protect": {
          "type": "boolean"
        },
        "rules": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "threshold": {
                "type": "integer"
              },
              "window_seconds": {
                "type": "integer"
              }
            },
            "required": [
              "enabled",
              "threshold",
              "window_seconds"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "source_geoip": {
          "additionalProperties": false,
          "properties": {
            "generation": {
              "type": "string"
            },
            "listeners": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "listen_ip": {
                    "type": "string"
                  },
                  "network": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                },
                "required": [
                  "port",
                  "network"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "prefixes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reference": {
              "type": "boolean"
            }
          },
          "required": [
            "generation",
            "listeners"
          ],
          "type": "object"
        },
        "ssh_port_ranges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "network": {
                "type": "string"
              },
              "to": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "ssh_ports": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "tcp_port_ranges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "network": {
                "type": "string"
              },
              "to": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "tcp_ports": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "udp_port_ranges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "network": {
                "type": "string"
              },
              "to": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "udp_ports": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "protect"
      ],
      "type": "object"
    },
    "inbound_certificates": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "member_outbounds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "providers": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "credentials": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "credentials"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "telemetry": {
      "additionalProperties": false,
      "properties": {
        "include_active_ips": {
          "type": "boolean"
        },
        "report_seconds": {
          "type": "integer"
        },
        "sample_seconds": {
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "torrent": {
      "additionalProperties": false,
      "properties": {
        "ban_seconds": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "updates": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "users": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "hourly"
              ]
            },
            "then": {
              "properties": {
                "accounting_period": {
                  "minLength": 1
                }
              },
              "required": [
                "accounting_period",
                "valid_until"
              ]
            }
          }
        ],
        "anyOf": [
          {
            "required": [
              "uuid"
            ]
          },
          {
            "required": [
              "credentials"
            ]
          }
        ],
        "properties": {
          "accounting_period": {
            "type": "string"
          },
          "active_ip_limit": {
            "minimum": 0,
            "type": "integer"
          },
          "block_new": {
            "type": "boolean"
          },
          "burst_speed_limit_mbps": {
            "minimum": 0,
            "type": "integer"
          },
          "connection_limit": {
            "minimum": 0,
            "type": "integer"
          },
          "credentials": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "hourly": {
            "additionalProperties": false,
            "properties": {
              "enrollment_id": {
                "pattern": "^(?!_xnode_)[A-Za-z0-9._-]{1,128}$",
                "type": "string"
              },
              "owner": {
                "additionalProperties": false,
                "properties": {
                  "generation": {
                    "pattern": "^[0-9]+$",
                    "type": "string"
                  },
                  "id": {
                    "pattern": "^(?!_xnode_)[A-Za-z0-9._-]{1,128}$",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "generation"
                ],
                "type": "object"
              }
            },
            "required": [
              "owner",
              "enrollment_id"
            ],
            "type": "object"
          },
          "id": {
            "minimum": 1,
            "type": "integer"
          },
          "inbound_tags": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "replaces_id": {
            "type": "integer"
          },
          "speed_limit_after_seconds": {
            "minimum": 0,
            "type": "integer"
          },
          "speed_limit_mbps": {
            "minimum": 0,
            "type": "integer"
          },
          "speed_limit_reset_seconds": {
            "minimum": 0,
            "type": "integer"
          },
          "transit_credentials": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "credential": {
                  "type": "object"
                },
                "generation": {
                  "type": "string"
                },
                "inbound_tag": {
                  "type": "string"
                },
                "source_node_id": {
                  "type": "string"
                }
              },
              "required": [
                "source_node_id",
                "inbound_tag",
                "generation",
                "credential"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "uuid": {
            "type": "string"
          },
          "valid_until": {
            "format": "date-time",
            "type": "string"
          },
          "whitelist_enabled": {
            "type": "boolean"
          },
          "whitelisted_ips": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "inbound_tags"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "xray": {
      "type": "object"
    }
  },
  "required": [
    "xray",
    "users"
  ],
  "title": "X-Node remote configuration",
  "type": "object"
}
